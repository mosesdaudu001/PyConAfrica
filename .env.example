# Published host ports. Override any that clash with something already running
# (a local Postgres on 5432 is the usual one).
PG_PUBLISH=5432
PGB_PUBLISH=6432
REDIS_PUBLISH=6379
APP_PUBLISH=8000

# Pin the whole stack to a fixed set of cores, e.g. APP_CPUSET=0-7 to make the
# container tier an 8-vCPU box. Leave EMPTY for unconstrained — setting a range
# wider than the host has cores makes Docker refuse to start the container.
APP_CPUSET=

# Configuration under test: see bench/configs.sh for the matrix.
BENCH_DRIVER=sync      # sync | async
BENCH_TARGET=pg        # pg | pgbouncer
BENCH_CACHE=off        # off | on
BENCH_WORKERS=1
