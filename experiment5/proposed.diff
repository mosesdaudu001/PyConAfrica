@@ -1537,6 +1537,39 @@
 app = FastAPI(title="Question Generation Service")
 
 
+# --- slide-4 instrumentation -------------------------------------------------
+# Splits every request into model / queue / python milliseconds and emits one
+# JSON line per request. Read-only: it adds no I/O to the hot path beyond a log
+# write, and changes no existing behaviour.
+from request_timing import begin_request, snapshot  # noqa: E402
+
+_timing_log = logging.getLogger("qgs.timing")
+
+
+@app.middleware("http")
+async def _request_timing_middleware(request, call_next):
+    begin_request()
+    started = time.perf_counter()
+    response = await call_next(request)
+    total_ms = (time.perf_counter() - started) * 1000.0
+    model_ms, queue_ms, model_calls = snapshot()
+    python_ms = total_ms - model_ms - queue_ms
+    _timing_log.info(json.dumps({
+        "path": request.url.path,
+        "status": response.status_code,
+        "total_ms": round(total_ms, 2),
+        "model_ms": round(model_ms, 2),
+        "queue_ms": round(queue_ms, 2),
+        "python_ms": round(python_ms, 2),
+        "model_calls": model_calls,
+        "model_share": round(model_ms / total_ms, 4) if total_ms > 0 else None,
+    }))
+    response.headers["X-Total-Ms"] = f"{total_ms:.1f}"
+    response.headers["X-Model-Ms"] = f"{model_ms:.1f}"
+    response.headers["X-Python-Ms"] = f"{python_ms:.1f}"
+    return response
+
+
 @app.on_event("shutdown")
 async def _shutdown_llm_resources():
     """Close the shared LLM ThreadPoolExecutor and aiohttp session on exit."""
